NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:dev@localhost:5440/pitoo
TEST_DATABASE_URL=postgresql://postgres:dev@localhost:5440/pitoo_test
APP_DATABASE_URL=postgresql://pitoo_app:pitoo_app_dev@localhost:5440/pitoo

# openssl rand -hex 32 (эсвэл node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") -оор шинээр үүсгэ
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string

# Seed script-ийн үүсгэх анхны админ дансны мэдээлэл
ADMIN_PHONE=99001122
ADMIN_TEMP_PASSWORD=ChangeMe123!

# Мэдэгдэл (М9). Хоосон бол тухайн суваг идэвхгүй, мэдэгдэл FAILED болж админд харагдана.
# Web Push: npx web-push generate-vapid-keys -оор үүсгэнэ
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pitoo.mn
# SMTP: хөгжүүлэлтэд docker compose-ийн mailpit (UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=Пи тоо <no-reply@pitoo.mn>
# Багш, салбарын оруулсан зураг хадгалах хавтас (apps/api-ийн дотор). Анхдагч: uploads
# UPLOAD_DIR=uploads
