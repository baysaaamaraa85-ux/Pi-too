# Railway-ийн service бүрийн хувьсагчийн ЗАГВАР. Энэ файл git-д орно, тиймээс жинхэнэ нууц утга БИЧИХГҮЙ.
# <...> гэсэн хэсгийг өөрөө үүсгэж Railway-ийн Variables хэсэгт (Raw Editor) оруулна. Файлыг шууд ачаалахгүй.
# ${{Service.VAR}} нь Railway-ийн өөр service-ийн хувьсагчийг иш татах синтакс (service-ийн нэр том жижиг
# үсгээрээ таарах ёстой: Postgres, api, worker, web, backup).
#
# Нууц үг, түлхүүр үүсгэх (PowerShell, 3 удаа ажиллуулж 3 өөр утга авна):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Үр дүн нь зөвхөн 0-9, a-f тэмдэгттэй тул URL-д аюулгүй (нууц үгийг DB-ийн хаягт оруулахад чухал).
#
# Дараах гурван утгыг үүсгэнэ:
#   <JWT_ACCESS>   64 тэмдэгт  (JWT_ACCESS_SECRET)
#   <JWT_REFRESH>  64 тэмдэгт  (JWT_REFRESH_SECRET), <JWT_ACCESS>-аас ӨӨР
#   <APP_DB_PW>    64 тэмдэгт  (pitoo_app DB хэрэглэгчийн нууц үг)

# ----------------------------------------------------------------------------------------------
# Service: Postgres   (Railway-ийн Postgres template. Хувьсагчийг Railway өөрөө үүсгэнэ, юу ч бичихгүй)
# Ашиглагдах: DATABASE_URL, PGHOST, PGPORT, PGDATABASE. Public Access-ийг асаахгүй.
# ----------------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------------
# Service: api      (Dockerfile: /deploy/docker/api.Dockerfile, volume: /data/uploads)
# ----------------------------------------------------------------------------------------------
RAILWAY_DOCKERFILE_PATH=/deploy/docker/api.Dockerfile
SERVICE_ROLE=api
NODE_ENV=production
PORT=3000
# Бодит Railway дээр хэмжсэн: API-д ирэх X-Forwarded-For нь "клиент, Railway edge, Railway дотоод" гэсэн 3 хаягтай,
# дээр нь Caddy-гийн холболт нэмэгдэнэ. Тиймээс итгэмжлэх замын тоо 3 (2 бол req.ip нь Railway edge болж алдаатай).
TRUST_PROXY=3
# Volume root-ийн эзэмшилтэй холбогддог тул заавал (багшийн зураг бичигдэхийн тулд).
RAILWAY_RUN_UID=0
UPLOAD_DIR=/data/uploads

# Нийтийн хаяг: web service-ийн домэйн. refresh cookie, имэйлийн холбоос үүгээр үүснэ.
APP_ORIGIN=https://${{web.RAILWAY_PUBLIC_DOMAIN}}

# DATABASE_URL: migration, seed (superuser). Зөвхөн pre-deploy команд ашиглана.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# APP_DATABASE_URL: аппликейшн (ФБШ-24: audit_log, ledger_entries-д UPDATE/DELETE эрхгүй). Нууц үгийг
# `pitoo_app` үүргийг pre-deploy үед (db:bootstrap) үүсгэхэд ашиглана, ямар ч өөр алхам хэрэггүй.
# Хэрэглэгчийн нэр заавал pitoo_app. <APP_DB_PW>-ийг шууд утгаар нь бич (Railway-ийн host, port, db нэрийг иш татна).
APP_DATABASE_URL=postgresql://pitoo_app:<APP_DB_PW>@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}

JWT_ACCESS_SECRET=<JWT_ACCESS>
JWT_REFRESH_SECRET=<JWT_REFRESH>

# Анхны админ (seed). Нэвтэрч нууц үгээ сольсны дараа ADMIN_TEMP_PASSWORD-ийг энд ХАС.
ADMIN_PHONE=<8 оронтой утас>
ADMIN_TEMP_PASSWORD=<8+ тэмдэгт, түр нууц үг>

# Мэдэгдэл (заавал биш). Тохируулаагүй суваг FAILED болж админд харагдана.
# Web Push: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:<төвийн имэйл>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Пи тоо <no-reply@<домэйн>>

# ----------------------------------------------------------------------------------------------
# Service: worker   (api-тай ИЖИЛ Dockerfile, өөр SERVICE_ROLE. Нийтийн домэйнгүй, нэг replica)
# env.ts нь worker дээр ч ижил хувьсагч шаарддаг тул api-аас иш татна.
# ----------------------------------------------------------------------------------------------
RAILWAY_DOCKERFILE_PATH=/deploy/docker/api.Dockerfile
SERVICE_ROLE=worker
NODE_ENV=production
APP_ORIGIN=${{api.APP_ORIGIN}}
DATABASE_URL=${{Postgres.DATABASE_URL}}
APP_DATABASE_URL=${{api.APP_DATABASE_URL}}
JWT_ACCESS_SECRET=${{api.JWT_ACCESS_SECRET}}
JWT_REFRESH_SECRET=${{api.JWT_REFRESH_SECRET}}
VAPID_SUBJECT=${{api.VAPID_SUBJECT}}
# api-д VAPID_*, SMTP_* тохируулсан бол энд мөн адил иш татна, жишээ нь:
# VAPID_PUBLIC_KEY=${{api.VAPID_PUBLIC_KEY}}
# SMTP_HOST=${{api.SMTP_HOST}}

# ----------------------------------------------------------------------------------------------
# Service: web      (Dockerfile: /deploy/docker/web.Dockerfile. Нийтийн домэйн ЗӨВХӨН энэ service-д)
# ----------------------------------------------------------------------------------------------
RAILWAY_DOCKERFILE_PATH=/deploy/docker/web.Dockerfile
PORT=8080
# Caddy /api, /uploads, /health-ийг энд дамжуулна (Railway-ийн дотоод сүлжээ, http://, портыг api-ийн PORT-той тааруул).
API_UPSTREAM=${{api.RAILWAY_PRIVATE_DOMAIN}}:3000

# ----------------------------------------------------------------------------------------------
# Service: backup   (Dockerfile: /deploy/docker/backup.Dockerfile. Cron Schedule: 0 20 * * *  (UTC) = 04:00 Улаанбаатар)
# Заавал биш боловч ФБШ-16-ыг хангахад шаардлагатай. S3-тэй тохирох bucket хэрэгтэй.
# ----------------------------------------------------------------------------------------------
RAILWAY_DOCKERFILE_PATH=/deploy/docker/backup.Dockerfile
# Postgres service-ийн хувилбартай ижил эсвэл түүнээс шинэ (DEPLOY.md-ийн "Postgres хувилбар"-ыг үз)
PG_MAJOR=16
DATABASE_URL=${{Postgres.DATABASE_URL}}
BACKUP_S3_BUCKET=<bucket-ийн нэр>
BACKUP_S3_ENDPOINT=<S3-тэй тохирох үйлчилгээний хаяг, AWS S3 бол энэ мөрийг хас>
AWS_ACCESS_KEY_ID=<түлхүүр>
AWS_SECRET_ACCESS_KEY=<нууц түлхүүр>
AWS_DEFAULT_REGION=<бүс, жишээ нь auto эсвэл us-east-1>
BACKUP_PREFIX=pitoo
BACKUP_RETENTION_DAYS=30
